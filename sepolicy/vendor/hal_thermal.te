hal_server_domain(hal_thermal_default, hal_thermal)
init_daemon_domain(hal_thermal_default)
allow hal_thermal_default vendor_configs_file:dir r_dir_perms;
allow hal_thermal_default vendor_configs_file:file r_file_perms;
allow hal_thermal_default vendor_task_profiles_file:dir r_dir_perms;
allow hal_thermal_default vendor_task_profiles_file:file r_file_perms;
allow hal_thermal_default sysfs_batteryinfo:file r_file_perms;
allow hal_thermal_default sysfs_batteryinfo:dir search;
