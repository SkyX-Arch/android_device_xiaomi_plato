# Battery
type vendor_sysfs_qcom_battery, fs_type, sysfs_type;

# Camera
type camera_persist_file, file_type;
type camlog_device, dev_type;
type sys_thermal_flash_state, fs_type, sysfs_type;
type sys_thermal_torch_real_level, fs_type, sysfs_type;
type sysfs_csiphy_umd_paras, fs_type, sysfs_type;
type vendor_camera_data_file, file_type, data_file_type;
type crossbuild_vendor_file, file_type, vendor_file_type;

# Charger
type vendor_sysfs_xm_power, fs_type, sysfs_type;

# Diag
type minidump_data_file, data_file_type, file_type;
type vendor_bsp_data_log_file, data_file_type, file_type;

# Display
type vendor_sysfs_displayfeature, fs_type, sysfs_type;
type vendor_display_config_file, vendor_file_type, file_type;

# Fingerprint
type sysfs_tp_fodstatus, fs_type, sysfs_type;

# Info
type vendor_sysfs_hardwareinfo, fs_type, sysfs_type;

# IR
type ir_spi_device, dev_type;

# Metis/Migt
type migt_dev, dev_type, mlstrustedobject;
type sysfs_migt, fs_type, sysfs_type;

# Memory
type procfs_memory, fs_type, proc_type;

# Sensor
type vendor_aon_vendor_data_file, data_file_type, file_type;
type vendor_persist_sensors_file, file_type, data_file_type;
type vendor_sysfs_data, fs_type, sysfs_type;
type vendor_sysfs_graphics, fs_type, sysfs_type;

# Thermal
type sys_thermal_wifi_limit, fs_type, sysfs_type;
type sysfs_power_save, fs_type, sysfs_type;
type sysfs_poweraware, fs_type, sysfs_type;
type thermal_data_file, data_file_type, file_type;

# Touchfeature
type proc_tp_file, fs_type, proc_type;
type proc_tp_lockdown, fs_type, proc_type;
type sysfs_touch_hostprocess, fs_type, sysfs_type;
type sysfs_touch_suspend, fs_type, sysfs_type;
type sysfs_tp_virtual_prox, fs_type, sysfs_type;
type touchreport_data_file, data_file_type, file_type;
type vendor_data_touchreport_file, data_file_type, file_type;
type tpevent, dev_type, file_type;

# Walt
type proc_walt, fs_type, proc_type;

# Wlan
type vendor_mac_vendor_data_file, data_file_type, file_type, mlstrustedobject;

# Allow the ART compiler to read memory state
allow artd proc_overcommit_memory:file r_file_perms;

# Allow the crash debugger to read memory state
allow crash_dump proc_overcommit_memory:file r_file_perms;

# Allow the shell (shell/adb) to read this file
allow shell proc_overcommit_memory:file r_file_perms;

#GPU
type vendor_sysfs_gpu, fs_type, sysfs_type;
