# ========================================================
# ANDROID 16 MAXIMUM SYSTEM TUNING (PLATO)
# ========================================================

# SurfaceFlinger Core Display & DRM Configuration
ro.surface_flinger.primary_display_orientation=ORIENTATION_0
ro.surface_flinger.protected_contents=true
ro.surface_flinger.has_HDR_display=true
ro.surface_flinger.has_wide_color_display=true
ro.surface_flinger.supports_background_blur=1

# Precise Frame Pacing & Phase Offsets (120Hz Fluidity)
debug.sf.use_phase_offsets_as_durations=1
debug.sf.late.sf.duration=13800000
debug.sf.late.app.duration=10000000
debug.sf.early.sf.duration=13800000
debug.sf.early.app.duration=10000000
debug.sf.earlyGl.sf.duration=13800000
debug.sf.earlyGl.app.duration=13800000
debug.sf.hwc.min.duration=8500000

# SurfaceFlinger Composition & Triple Buffering Optimizations
debug.sf.enable_gl_backpressure=1
debug.sf.auto_latch_unsignaled=0
debug.sf.enable_hwc_vds=0
debug.sf.predict_hwc_composition_strategy=0
debug.sf.enable_egl_image_tracker=0
debug.sf.enable_transaction_tracing=false
ro.surface_flinger.max_frame_buffer_acquired_buffers=6
ro.surface_flinger.force_hwc_copy_for_virtual_displays=true

# Smart VRR Display Timers (120Hz to 60Hz Drop)
ro.surface_flinger.set_display_power_timer_ms=1000
ro.surface_flinger.set_touch_timer_ms=1100
ro.surface_flinger.set_idle_timer_ms=1100
ro.surface_flinger.use_content_detection_for_refresh_rate=true
ro.surface_flinger.enable_frame_rate_override=false
debug.sf.frame_rate_multiple_threshold=60

# Native Color Management Bridge
ro.surface_flinger.use_color_management=true
debug.sf.treat_170m_as_sRGB=1
persist.sys.sf.color_mode=9
persist.sys.sf.native_mode=2
persist.sys.sf.color_saturation=1.0

# Cpu Scheduler Clamping & Rendering Performance
ro.surface_flinger.uclamp.min=160
persist.sys.activity_anim_perf_override=true
debug.graphics.game_default_frame_rate.disabled=true
debug.hwui.skia_tracing_enabled=false
debug.hwui.skia_use_perfetto_track_events=false

# Media Framework Core Config
debug.stagefright.c2inputsurface=-1
debug.mediatek.appgamepq_compress=1
debug.mediatek.disp_decompress=1

# Global Audio Framework Tuning
audio.deep_buffer.media=true
audio.offload.video=true
audio.offload.min.duration.secs=30
ro.audio.monitorRotation=true
ro.config.media_vol_default=10
ro.config.vc_call_vol_steps=11

# Camera Framework Global Switch
camera.disable_zsl_mode=0

# Dex2oat Extreme Compilation (Dimensity 8100 Ultra Full Core Mapping)
dalvik.vm.dex2oat-cpu-set=0,1,2,3,4,5,6,7
dalvik.vm.dex2oat-threads=6
dalvik.vm.image-dex2oat-cpu-set=0,1,2,3,4,5,6,7
dalvik.vm.image-dex2oat-threads=8

# Global Telephony Framework Config (Android 16 Core)
persist.radio.multisim.config=dsds
ro.telephony.default_network=33,33,33,33
ro.telephony.iwlan_operation_mode=AP-assisted
ro.telephony.sim.count=2
telephony.active_modems.max_count=2
telephony.lteOnCdmaDevice=1
ro.lunaris.maintainer=SkyX-Arch
